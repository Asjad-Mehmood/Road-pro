<Window x:Class="RoadPro.Hub.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="RoadPro Hub" Width="1060" Height="740" MinWidth="900" MinHeight="600"
        WindowStartupLocation="CenterScreen" Background="{StaticResource Paper}"
        Icon="Assets/RoadPro.ico" FontFamily="{StaticResource TextFont}" FontSize="13.5" Foreground="{StaticResource Ink}"
        TextOptions.TextFormattingMode="Display" UseLayoutRounding="True">
    <!-- the Survey Toolkit's look (App.xaml): a white bar, a navy banner, white cards -->
    <Window.Resources>
        <FontFamily x:Key="Icons">Segoe Fluent Icons, Segoe MDL2 Assets</FontFamily>
        <Style x:Key="Glyph" TargetType="TextBlock">
            <Setter Property="FontFamily" Value="{StaticResource Icons}" />
            <Setter Property="FontSize" Value="17" />
            <Setter Property="Foreground" Value="{StaticResource Navy}" />
            <Setter Property="VerticalAlignment" Value="Center" />
        </Style>
        <Style x:Key="DocTitle" TargetType="TextBlock">
            <Setter Property="FontWeight" Value="SemiBold" />
            <Setter Property="Foreground" Value="{StaticResource Ink}" />
        </Style>
        <Style x:Key="DocText" TargetType="TextBlock">
            <Setter Property="FontWeight" Value="Normal" />
            <Setter Property="FontSize" Value="11.5" />
            <Setter Property="Foreground" Value="{StaticResource Muted}" />
            <Setter Property="TextTrimming" Value="CharacterEllipsis" />
        </Style>
    </Window.Resources>

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <!-- ============ top bar ============ -->
        <Border Background="{StaticResource Card}" BorderBrush="{StaticResource Line}" BorderThickness="0,0,0,1" Padding="20,12">
            <DockPanel>
                <TextBlock DockPanel.Dock="Right" VerticalAlignment="Center" FontSize="12.5">
                    <Hyperlink NavigateUri="https://www.exceltokml.com/" RequestNavigate="OnNavigate" Foreground="{StaticResource Navy}"
                               TextDecorations="{x:Null}" FontWeight="SemiBold">www.exceltokml.com</Hyperlink>
                </TextBlock>
                <StackPanel Orientation="Horizontal">
                    <Border Width="34" Height="34" CornerRadius="9" ClipToBounds="True">
                        <Border.Background>
                            <ImageBrush ImageSource="Assets/RoadPro_256.png" RenderOptions.BitmapScalingMode="HighQuality" />
                        </Border.Background>
                    </Border>
                    <TextBlock Text="RoadPro Hub" FontSize="19" FontWeight="ExtraBold" VerticalAlignment="Center" Margin="12,0,10,0" />
                    <Border Background="{StaticResource CardSoft}" BorderBrush="{StaticResource Line}" BorderThickness="1"
                            CornerRadius="99" Padding="9,3" VerticalAlignment="Center">
                        <TextBlock x:Name="HubVersionText" Text="VERSION" FontSize="10.5" FontWeight="Bold" Foreground="{StaticResource Muted}" />
                    </Border>
                </StackPanel>
            </DockPanel>
        </Border>

        <!-- ============ page ============ -->
        <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto">
            <StackPanel Margin="20,18,20,22" MaxWidth="1100">

                <!-- the banner: where RoadPro stands, in one line -->
                <Border Background="{StaticResource Hero}" CornerRadius="16" Padding="26,22" Margin="0,0,0,14">
                    <DockPanel>
                        <TextBlock x:Name="HeroIcon" Style="{StaticResource Glyph}" Text="&#xE930;" FontSize="34"
                                   Foreground="{StaticResource Gold}" Margin="0,0,18,0" />
                        <StackPanel VerticalAlignment="Center">
                            <TextBlock x:Name="HeroTitle" Text="RoadPro" Foreground="White" FontSize="21" FontWeight="Bold" TextWrapping="Wrap" />
                            <TextBlock x:Name="HeroText" Foreground="#C3CFE6" FontSize="13.5" Margin="0,4,0,0" TextWrapping="Wrap" />
                        </StackPanel>
                    </DockPanel>
                </Border>

                <!-- a note: AutoCAD open, another copy installed for all users -->
                <Border x:Name="Banner" Visibility="Collapsed" Background="{StaticResource WarnSoft}" BorderBrush="{StaticResource WarnLine}"
                        BorderThickness="1" CornerRadius="12" Padding="14,11" Margin="0,0,0,14">
                    <DockPanel>
                        <TextBlock Style="{StaticResource Glyph}" Text="&#xE946;" Foreground="{StaticResource Ink}" VerticalAlignment="Top" Margin="0,1,10,0" />
                        <TextBlock x:Name="BannerText" TextWrapping="Wrap" Foreground="{StaticResource Ink}" FontWeight="Medium" LineHeight="19" />
                    </DockPanel>
                </Border>

                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="14" />
                        <ColumnDefinition Width="*" />
                    </Grid.ColumnDefinitions>

                    <!-- ============ left: the plugin and updates ============ -->
                    <StackPanel Grid.Column="0">

                        <Border Style="{StaticResource CardBorder}">
                            <StackPanel>
                                <DockPanel>
                                    <Border DockPanel.Dock="Left" Width="46" Height="46" CornerRadius="12" Background="{StaticResource CardSoft}"
                                            BorderBrush="{StaticResource Line}" BorderThickness="1" Margin="0,0,14,0">
                                        <TextBlock Style="{StaticResource Glyph}" Text="&#xE8B0;" FontSize="21" HorizontalAlignment="Center" Foreground="{StaticResource Ink}" />
                                    </Border>
                                    <StackPanel VerticalAlignment="Center">
                                        <TextBlock Text="RoadPro" FontSize="17" FontWeight="SemiBold" />
                                        <TextBlock Text="AutoCAD plugin" Foreground="{StaticResource Muted}" Margin="0,1,0,0" />
                                    </StackPanel>
                                </DockPanel>

                                <WrapPanel Margin="0,14,0,0">
                                    <Border x:Name="StatePill" CornerRadius="99" Padding="10,4" Margin="0,0,10,0" VerticalAlignment="Center"
                                            Background="{StaticResource GoodFill}">
                                        <TextBlock x:Name="StateText" FontWeight="Bold" FontSize="11" Foreground="{StaticResource GoodOnFill}" Text="..." />
                                    </Border>
                                    <TextBlock x:Name="InstalledText" FontWeight="Medium" VerticalAlignment="Center" />
                                </WrapPanel>
                                <TextBlock x:Name="AvailableText" Foreground="{StaticResource Muted}" Margin="0,8,0,0" />
                                <TextBlock x:Name="LocationText" Foreground="{StaticResource Muted}" FontSize="11.5" Margin="0,3,0,0" TextTrimming="CharacterEllipsis" />

                                <WrapPanel Margin="0,16,0,0">
                                    <Button x:Name="InstallButton" Style="{StaticResource PrimaryButton}" Content="Install" Click="OnInstall" Margin="0,0,10,8" />
                                    <Button x:Name="RepairButton" Style="{StaticResource TonalButton}" Content="Repair" Click="OnInstall" Margin="0,0,10,8" />
                                    <Button x:Name="UninstallButton" Style="{StaticResource SecondaryButton}" Content="Uninstall" Click="OnUninstall" Margin="0,0,10,8" />
                                    <Button x:Name="RestoreButton" Style="{StaticResource SecondaryButton}" Content="Restore previous version" Click="OnRestore" Margin="0,0,0,8" />
                                </WrapPanel>

                                <ProgressBar x:Name="Busy" IsIndeterminate="True" Height="4" Margin="0,8,0,0" Visibility="Collapsed" />
                                <TextBlock x:Name="ResultText" TextWrapping="Wrap" Margin="0,10,0,0" Visibility="Collapsed" FontWeight="Medium" />
                            </StackPanel>
                        </Border>

                        <Border Style="{StaticResource CardBorder}">
                            <StackPanel>
                                <DockPanel>
                                    <Button x:Name="CheckButton" DockPanel.Dock="Right" Style="{StaticResource SecondaryButton}" Content="Check now"
                                            MinWidth="0" Padding="12,5" Margin="0" FontSize="12.5" Click="OnCheckUpdates" VerticalAlignment="Center" />
                                    <TextBlock Style="{StaticResource CardTitle}" Text="UPDATES" VerticalAlignment="Center" />
                                </DockPanel>
                                <TextBlock x:Name="UpdateText" TextWrapping="Wrap" Margin="0,12,0,0" Text="Checking for updates..." FontWeight="Medium" />
                                <TextBlock x:Name="UpdateNotes" Foreground="{StaticResource Muted}" FontSize="12.5" TextWrapping="Wrap" Margin="0,4,0,0" Visibility="Collapsed" />
                                <WrapPanel x:Name="UpdateActions" Margin="0,14,0,0" Visibility="Collapsed">
                                    <Button x:Name="UpdateNowButton" Style="{StaticResource PrimaryButton}" Content="Update now" Click="OnUpdateNow" />
                                    <Button x:Name="SkipButton" Style="{StaticResource SecondaryButton}" Content="Skip this version" Click="OnSkipUpdate" />
                                </WrapPanel>
                                <ProgressBar x:Name="UpdateProgress" Height="4" Maximum="1" Margin="0,14,0,0" Visibility="Collapsed" />
                                <Border Background="{StaticResource CardSoft}" BorderBrush="{StaticResource Line}" BorderThickness="1"
                                        CornerRadius="12" Padding="14,10" Margin="0,16,0,0">
                                    <CheckBox x:Name="AutoCheckBox" Content="Check for updates when Windows starts (once a day)" VerticalContentAlignment="Center"
                                              Foreground="{StaticResource Ink}" Checked="OnAutoCheckChanged" Unchecked="OnAutoCheckChanged" />
                                </Border>
                            </StackPanel>
                        </Border>
                    </StackPanel>

                    <!-- ============ right: AutoCAD and help ============ -->
                    <StackPanel Grid.Column="2">

                        <Border Style="{StaticResource CardBorder}">
                            <StackPanel>
                                <DockPanel>
                                    <Button DockPanel.Dock="Right" Style="{StaticResource SecondaryButton}" Content="Refresh"
                                            MinWidth="0" Padding="12,5" Margin="0" FontSize="12.5" Click="OnRefresh" />
                                    <TextBlock Style="{StaticResource CardTitle}" Text="AUTOCAD ON THIS COMPUTER" VerticalAlignment="Center" />
                                </DockPanel>
                                <TextBlock x:Name="AcadEmpty" Visibility="Collapsed" Foreground="{StaticResource Muted}" TextWrapping="Wrap" Margin="0,12,0,0" LineHeight="19"
                                           Text="No AutoCAD-based program was found. RoadPro needs AutoCAD 2013 or newer, Civil 3D, Map 3D or another AutoCAD-based program (not AutoCAD LT)." />
                                <ItemsControl x:Name="AcadList" Margin="0,12,0,0">
                                    <ItemsControl.ItemTemplate>
                                        <DataTemplate>
                                            <Border Background="{StaticResource CardSoft}" BorderBrush="{StaticResource Line}" BorderThickness="1"
                                                    CornerRadius="12" Padding="12,10" Margin="0,0,0,8">
                                                <DockPanel>
                                                    <Border DockPanel.Dock="Right" CornerRadius="99" Padding="10,3" VerticalAlignment="Center" Background="{Binding BadgeBackground}">
                                                        <TextBlock Text="{Binding Badge}" Foreground="{Binding BadgeForeground}" FontWeight="Bold" FontSize="11" />
                                                    </Border>
                                                    <TextBlock DockPanel.Dock="Left" Style="{StaticResource Glyph}" Text="&#xE7F4;" Foreground="{StaticResource Ink}" Margin="2,0,12,0" />
                                                    <StackPanel>
                                                        <TextBlock Text="{Binding Title}" FontWeight="SemiBold" Foreground="{StaticResource Ink}" />
                                                        <TextBlock Text="{Binding Detail}" Foreground="{StaticResource Muted}" FontSize="11.5" Margin="0,2,0,0" TextTrimming="CharacterEllipsis" />
                                                    </StackPanel>
                                                </DockPanel>
                                            </Border>
                                        </DataTemplate>
                                    </ItemsControl.ItemTemplate>
                                </ItemsControl>
                                <TextBlock Foreground="{StaticResource Muted}" FontSize="12.5" TextWrapping="Wrap" Margin="0,4,0,0" LineHeight="18"
                                           Text="Start AutoCAD or Civil 3D: RoadPro loads in every drawing. Type RDP to build a road, RDHELP for all commands." />
                            </StackPanel>
                        </Border>

                        <Border Style="{StaticResource CardBorder}">
                            <StackPanel>
                                <TextBlock Style="{StaticResource CardTitle}" Text="DOCUMENTS AND HELP" />
                                <UniformGrid Columns="2" Margin="0,12,0,0">
                                    <Button x:Name="GuideButton" Style="{StaticResource DocButton}" Margin="0,0,8,8" Click="OnOpenDoc" Tag="*User_Guide*.pdf">
                                        <DockPanel><TextBlock Style="{StaticResource Glyph}" Text="&#xE736;" Margin="0,0,12,0" />
                                            <StackPanel><TextBlock Text="User guide" Style="{StaticResource DocTitle}" /><TextBlock Text="Step by step, with pictures" Style="{StaticResource DocText}" /></StackPanel></DockPanel>
                                    </Button>
                                    <Button x:Name="ShortcutsButton" Style="{StaticResource DocButton}" Margin="0,0,0,8" Click="OnOpenDoc" Tag="*Shortcuts*.xlsx">
                                        <DockPanel><TextBlock Style="{StaticResource Glyph}" Text="&#xE765;" Margin="0,0,12,0" />
                                            <StackPanel><TextBlock Text="Shortcut keys" Style="{StaticResource DocTitle}" /><TextBlock Text="All commands (Excel)" Style="{StaticResource DocText}" /></StackPanel></DockPanel>
                                    </Button>
                                    <Button x:Name="NewsButton" Style="{StaticResource DocButton}" Margin="0,0,8,8" Click="OnOpenDoc" Tag="*WhatsNew*.txt">
                                        <DockPanel><TextBlock Style="{StaticResource Glyph}" Text="&#xE734;" Margin="0,0,12,0" />
                                            <StackPanel><TextBlock Text="What's new" Style="{StaticResource DocTitle}" /><TextBlock Text="Changes in this version" Style="{StaticResource DocText}" /></StackPanel></DockPanel>
                                    </Button>
                                    <Button x:Name="ReportButton" Style="{StaticResource DocButton}" Margin="0,0,0,8" Click="OnOpenDoc" Tag="*Test_Report*.pdf">
                                        <DockPanel><TextBlock Style="{StaticResource Glyph}" Text="&#xE9D9;" Margin="0,0,12,0" />
                                            <StackPanel><TextBlock Text="Test report" Style="{StaticResource DocTitle}" /><TextBlock Text="What was tested (PDF)" Style="{StaticResource DocText}" /></StackPanel></DockPanel>
                                    </Button>
                                    <Button Style="{StaticResource DocButton}" Margin="0,0,8,0" Click="OnOpenPluginFolder">
                                        <DockPanel><TextBlock Style="{StaticResource Glyph}" Text="&#xE8B7;" Margin="0,0,12,0" />
                                            <StackPanel><TextBlock Text="Plugin folder" Style="{StaticResource DocTitle}" /><TextBlock Text="Where AutoCAD loads RoadPro" Style="{StaticResource DocText}" /></StackPanel></DockPanel>
                                    </Button>
                                    <Button Style="{StaticResource DocButton}" Margin="0" Click="OnOpenLog">
                                        <DockPanel><TextBlock Style="{StaticResource Glyph}" Text="&#xE7C3;" Margin="0,0,12,0" />
                                            <StackPanel><TextBlock Text="Log file" Style="{StaticResource DocTitle}" /><TextBlock Text="For support questions" Style="{StaticResource DocText}" /></StackPanel></DockPanel>
                                    </Button>
                                </UniformGrid>
                            </StackPanel>
                        </Border>
                    </StackPanel>
                </Grid>

                <TextBlock HorizontalAlignment="Center" Foreground="{StaticResource Muted}" FontSize="12" Margin="0,4,0,0">
                    <Run Text="Developed by" />
                    <Hyperlink NavigateUri="https://www.exceltokml.com/" RequestNavigate="OnNavigate" Foreground="{StaticResource Navy}" TextDecorations="{x:Null}">exceltokml.com</Hyperlink>
                    <Run Text=" · SurveyX Digital" />
                </TextBlock>
            </StackPanel>
        </ScrollViewer>
    </Grid>
</Window>
