<Window x:Class="RoadPro.Hub.UpdatePromptWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="RoadPro update" Width="440" SizeToContent="Height" ResizeMode="NoResize"
        WindowStartupLocation="Manual" Topmost="True" ShowInTaskbar="True"
        Background="{StaticResource Card}" Icon="Assets/RoadPro.ico" FontFamily="{StaticResource TextFont}" Foreground="{StaticResource Ink}" FontSize="13"
        TextOptions.TextFormattingMode="Display" UseLayoutRounding="True">
    <Border BorderBrush="{StaticResource Navy}" BorderThickness="0,4,0,0">
        <Grid Margin="20,16,20,18">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="*" />
            </Grid.ColumnDefinitions>
            <Image Source="Assets/RoadPro_256.png" Width="48" Height="48" VerticalAlignment="Top" Margin="0,2,16,0"
                   RenderOptions.BitmapScalingMode="HighQuality" />
            <StackPanel Grid.Column="1">
                <TextBlock x:Name="TitleText" Text="RoadPro update available" FontSize="16" FontWeight="SemiBold" Foreground="{StaticResource Ink}" />
                <TextBlock x:Name="InfoText" Foreground="{StaticResource InkSoft}" TextWrapping="Wrap" Margin="0,6,0,0" />
                <TextBlock x:Name="NotesText" Foreground="{StaticResource Muted}" TextWrapping="Wrap" FontSize="12" Margin="0,6,0,0" />
                <ProgressBar x:Name="Progress" Height="6" Maximum="1" Margin="0,12,0,0" Visibility="Collapsed"
                             Foreground="{StaticResource Amber}" Background="{StaticResource Line}" BorderThickness="0" />
                <TextBlock x:Name="StatusText" TextWrapping="Wrap" Margin="0,8,0,0" Visibility="Collapsed" />
                <WrapPanel x:Name="Buttons" Margin="0,14,0,0">
                    <Button x:Name="UpdateButton" Style="{StaticResource PrimaryButton}" Content="Update now" Click="OnUpdate" />
                    <Button Style="{StaticResource SecondaryButton}" Content="Later" Click="OnLater" MinWidth="70" />
                    <Button Style="{StaticResource SecondaryButton}" Content="Skip this version" Click="OnSkip" MinWidth="0" Margin="0" />
                </WrapPanel>
            </StackPanel>
        </Grid>
    </Border>
</Window>
